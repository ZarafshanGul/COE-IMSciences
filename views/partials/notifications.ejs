<!-- Blur overlay -->
<% if (admissionNotices.length) { %>
<div class="notif-overlay" id="notifOverlay"></div>

<!-- Spoke admissions popup -->
<div class="notif-panel" id="notifPanel" role="dialog" aria-modal="true" aria-label="Admissions are now open">
  <button class="notif-close" id="notifClose" aria-label="Close">&times;</button>

  <div class="notif-body">
    <% admissionNotices.forEach(function(notice, index) { %>
      <section class="notif-content notif-centre" aria-labelledby="notifCentreTitle<%= index %>">
        <a href="/<%= notice.center.slug %>" class="notif-centre-label"><%= notice.center.applyLabel || notice.center.location %></a>
        <h2 id="notifCentreTitle<%= index %>">
          Admissions Are <span>Now Open!</span>
          <span class="notif-subtitle"><%= notice.admissions.title %></span>
        </h2>
        <p class="notif-query">
          For queries, please contact:
          <a href="mailto:<%= notice.admissions.contactEmail %>"><%= notice.admissions.contactEmail %></a>
        </p>
        <div class="notif-btn-row">
          <a href="<%= notice.admissions.applyLink %>" target="_blank" rel="noopener noreferrer" class="btn btn-brand notif-apply-btn">Apply Now</a>
          <a href="/<%= notice.center.slug %>" class="btn notif-details-btn">View Full Details</a>
        </div>
      </section>
    <% }); %>
  </div>
</div>
<% } %>
