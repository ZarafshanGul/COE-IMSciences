<!-- Skardu Admissions Popup Overlay -->
<div class="skardu-notif-overlay" id="skarduNotifOverlay"></div>

<!-- Skardu Admissions Popup -->
<div
  class="skardu-notif-panel"
  id="skarduNotifPanel"
  role="dialog"
  aria-modal="true"
  aria-label="Skardu admissions are now open"
>

  <!-- Close Button -->
  <button
    class="skardu-notif-close"
    id="skarduNotifClose"
    aria-label="Close"
  >
    &times;
  </button>

  <div class="skardu-notif-body">

    <!-- Admission Poster -->
    <div class="skardu-notif-image">
      <img
        src="/images/skardu-admissions.jpg"
        alt="Centre of Excellence Skardu Admissions"
      >
    </div>

    <!-- Popup Content -->
    <div class="skardu-notif-content">

      <h2>
        Admissions Are Now Open!

        <span class="skardu-notif-subtitle">
          Centre of Excellence, Government Polytechnic Institute, Skardu
        </span>
      </h2>

      <p class="skardu-notif-query">
        For queries, please contact:

        <a href="mailto:asimali@gbdtesd.gov.pk">
          asimali@gbdtesd.gov.pk
        </a>
      </p>

      <a
        href="https://forms.gle/jBY3jdBfJU2HsxaJ7"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-brand skardu-notif-apply-btn"
      >
        Apply Now
      </a>

    </div>

  </div>

</div>