<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { pageTitle: pageTitle }) %></head>
<body>
<div class="page-bg"></div>
<%- include('partials/header') %>

<main>
  <div class="container-xxl px-3 px-md-4 px-lg-5 py-5">

        <!-- Breadcrumb -->
        <nav class="cd-breadcrumb mb-4" aria-label="Breadcrumb">
          <a href="/">← Back to Home</a>
        </nav>

        <!-- Hero -->
        <div class="spoke-intro mb-4">
          <h1 class="cd-title spoke-intro-title mb-3"><%= spoke.title %></h1>
          <% if (spoke.heroImage) { %>
            <div class="spoke-intro-image">
              <img src="<%= spoke.heroImage %>" alt="<%= spoke.heroImageAlt %>" class="spoke-hero-img img-fluid" />
            </div>
          <% } %>
          <div class="spoke-intro-copy">
            <p class="cd-tagline mb-0"><%= spoke.tagline %></p>
          </div>
        </div>

        <!-- Courses Offered -->
        <div class="cd-card card border-0 p-4 p-md-5 mb-4">
          <h2 class="fw-bold mb-4" style="font-size:1.5rem;">Courses Offered</h2>
          <div class="row g-2">
            <% spoke.courses.forEach(function(c, courseIndex) { %>
              <div class="col-12 col-sm-6 <%= spoke.courses.length === 2 ? 'col-lg-6' : 'col-lg-4' %>">
                  <% if (spoke.courseSlugs && spoke.courseSlugs[courseIndex]) { %>
                    <a href="/courses/<%= spoke.courseSlugs[courseIndex] %>?center=<%= spoke.slug %>" class="cat-pill text-decoration-none">
                      <span class="cat-dot">•</span>
                      <span><%= c %></span>
                    </a>
                  <% } else { %>
                    <div class="cat-pill">
                      <span class="cat-dot">•</span>
                      <span><%= c %></span>
                    </div>
                  <% } %>
              </div>
            <% }); %>
          </div>
        </div>

        <!-- Eligibility Criteria -->
        <div class="cd-card card border-0 p-4 p-md-5 mb-4">
          <h2 class="fw-bold mb-4" style="font-size:1.5rem;">Eligibility Criteria</h2>

          <% spoke.eligibilityGroups.forEach(function(group) { %>
            <% if (spoke.eligibilityGroups.length > 1) { %>
              <p class="cd-meta-label mb-2"><%= group.title %></p>
            <% } %>
            <div class="row g-2 mb-3">
              <% group.items.forEach(function(item) { %>
                <div class="col-12 col-sm-6">
                  <div class="cd-learn-item">
                    <svg class="cd-check" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                    <span><%= item %></span>
                  </div>
                </div>
              <% }); %>
            </div>
          <% }); %>

          <% if (spoke.note) { %>
            <div class="cd-card card border-0 p-3 mt-2">
              <p class="mb-0" style="color:var(--text-dark); font-weight:600; font-size:0.9rem;">
                <span style="color:var(--secondary);">Note:</span> <%= spoke.note %>
              </p>
            </div>
          <% } %>
        </div>

        <% if (spoke.benefits && spoke.benefits.length) { %>
          <div class="cd-card card border-0 p-4 p-md-5 mb-4">
            <h2 class="fw-bold mb-4" style="font-size:1.5rem;">Programme Benefits</h2>
            <div class="row g-2">
              <% spoke.benefits.forEach(function(benefit) { %>
                <div class="col-12 col-sm-6">
                  <div class="cd-learn-item">
                    <svg class="cd-check" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                    <span><%= benefit %></span>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>

        <!-- Location & Contact -->
        <div class="cd-card card border-0 p-4 p-md-5 mb-4">
          <h2 class="fw-bold mb-4" style="font-size:1.5rem;">Location &amp; Contact</h2>

          <div class="row g-3">
            <div class="col-12 col-sm-6">
              <div class="cd-card card border-0 p-3 h-100">
                <p class="cd-meta-label mb-1">For Queries, Contact</p>
                <p class="cd-meta-value mb-0">
                  <a href="mailto:<%= spoke.contactEmail %>" class="spoke-contact-link">
                    <%= spoke.contactEmail %>
                  </a>
                  <% if (spoke.contactPhone) { %>
                    <br /><%= spoke.contactPhone %>
                  <% } %>
                </p>
              </div>
            </div>
            <div class="col-12 col-sm-6">
              <div class="cd-card card border-0 p-3 h-100">
                <p class="cd-meta-label mb-1">Address</p>
                <p class="cd-meta-value mb-0">
                  <a href="<%= spoke.mapLink %>" target="_blank" rel="noopener noreferrer"
                    class="spoke-contact-link">
                    <%= spoke.address %>
                  </a>
                </p>
              </div>
            </div>
          </div>

          <% if (spoke.deadline) { %>
            <p class="mt-3 mb-0" style="color:var(--text-light); font-size:0.9rem;">
              <span class="fw-bold" style="color:var(--secondary);">Last date for submission:</span>
              <%= spoke.deadline %>. Applications received after the due date will not be entertained.
            </p>
          <% } %>
        </div>

        <!-- CTA -->
        <% if (spoke.registrationsOpen && spoke.applyLink) { %>
          <div class="cd-cta-box">
            <p class="fw-semibold mb-4" style="font-size:1.2rem; color:var(--text-dark);">
              Ready to apply for training at <%= spoke.title %>?
            </p>
            <a href="<%= spoke.applyLink %>"
               target="_blank" rel="noopener noreferrer"
               class="btn btn-brand rounded-pill px-5 py-3 fw-bold"
               style="font-size:1.05rem;">
              Apply Now
            </a>
          </div>
        <% } else { %>
          <div class="cd-cta-box cd-cta-box--closed">
            <p class="fw-semibold mb-4" style="font-size:1.1rem; color:var(--text-dark);">
              Registrations for this centre are currently closed.
            </p>
            <a href="/" class="btn btn-brand-outline rounded-pill px-5 py-3 fw-bold">
              Back to Home
            </a>
          </div>
        <% } %>

  </div>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
</body>
</html>
